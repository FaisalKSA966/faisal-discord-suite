name: CI

on:
  push:
    branches: ["**"]
  pull_request:
    branches: ["main"]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
      - name: Install system deps
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            build-essential python3 pkg-config \
            libsqlite3-dev libtool autoconf automake
      - name: Install npm deps
        run: npm install --no-audit --no-fund
      - name: Typecheck bot
        run: npm run -w bot typecheck
      - name: Build bot
        run: npm run -w bot build
      - name: Typecheck companion
        run: npm run -w companion typecheck
