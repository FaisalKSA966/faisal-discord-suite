# =====================================================
#  Companion App — Windows 10 (Self-bot)
#  ⚠️  يستخدم حساب ديسكورد عادي (User Account) — مخالف لـ ToS.
#  استخدم حساب احتياطي مخصص لهذا الغرض فقط.
#  انسخ هذا الملف إلى companion/.env واملأ القيم.
# =====================================================

# توكن حساب الـ companion (حساب مستخدم عادي، مو بوت).
# استخراجه: افتح ديسكورد ويب https://discord.com → F12 → Network → فلتر "users" →
# اضغط أي طلب → في Headers انسخ قيمة "authorization".
DISCORD_USER_TOKEN=

# (اختياري) كلمة سر الحساب — لازمة فقط لتغيير اسم الـ Username (مو Display Name).
# لو ما عبيّتها، أوامر `/account name` راح ترجع خطأ من ديسكورد.
ACCOUNT_PASSWORD=

# معرّفات السيرفر والروم الصوتي الذي سيدخله الحساب
TARGET_GUILD_ID=
TARGET_VOICE_CHANNEL_ID=

# اتصال البوت ↔ companion
BOT_WS_URL=ws://localhost:8787
BOT_AUTH_TOKEN=change-me-to-a-long-random-string
LISTEN_PORT=8788

# دقة وعدد إطارات تسجيل الشاشة
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
CAPTURE_FPS=15

# مسار حفظ مقاطع الفيديو
OUTPUT_DIR=./out

# ─── Windows ───
# اسم جهاز الصوت في DirectShow لـ ffmpeg.
# اعرفه من PowerShell:  ffmpeg -list_devices true -f dshow -i dummy
# أمثلة: "Stereo Mix (Realtek Audio)"  أو  "CABLE Output (VB-Audio Virtual Cable)"
# اتركه فاضي لتسجيل فيديو فقط (بدون صوت).
WINDOWS_AUDIO_DEVICE=

# نقطة بداية gdigrab (لو عندك شاشة ثانية، حدد إحداثياتها)
WINDOWS_GRAB_X=0
WINDOWS_GRAB_Y=0

# مسار ffmpeg.exe (لو مو في PATH). مثال: C:\\ffmpeg\\bin\\ffmpeg.exe
FFMPEG_PATH=

# ─── Browser ───
BROWSER_PROFILE_DIR=./companion-profile
HEADLESS=false       # على ويندوز ما يصير headless لأن سكرين شير يحتاج desktop حقيقي
AUTO_JOIN_VOICE=true
