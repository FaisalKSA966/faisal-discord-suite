# =====================================================
#  Companion App — VPS Screen Capture
#  ⚠️ يحتاج حساب ديسكورد ثاني (مو البوت).
#  انسخ هذا الملف إلى companion/.env واملأ القيم.
# =====================================================

# توكن حساب الـ companion (حساب مستخدم عادي، مو بوت)
# للحصول عليه: افتح ديسكورد ويب، DevTools -> Console -> اكتب:
#   webpackChunkdiscord_app.push([[Math.random()],{},r=>{for(let e in r.c)try{for(let t in r.c[e].exports)if(r.c[e].exports[t]&&r.c[e].exports[t].getToken)return console.log(r.c[e].exports[t].getToken())}catch(e){}}])
# ⚠️ هذا الحساب راح يتحظر في النهاية. استخدم حساب احتياطي.
DISCORD_USER_TOKEN=

# معرّف السيرفر والروم الذي سيدخله الحساب لتصوير الشاشة
TARGET_GUILD_ID=
TARGET_VOICE_CHANNEL_ID=

# عنوان البوت الرسمي (WebSocket) للتواصل
BOT_WS_URL=ws://localhost:8787
BOT_AUTH_TOKEN=change-me

# منفذ الاستماع المحلي (لو احتجت debug)
LISTEN_PORT=8788

# دقة التصوير وعدد الإطارات
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
CAPTURE_FPS=15

# مسار حفظ الـ outputs
OUTPUT_DIR=./out

# مسار ملف بروفايل المتصفح (يفضّل ثابت لتجنب إعادة تسجيل الدخول)
BROWSER_PROFILE_DIR=./companion-profile
